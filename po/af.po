msgstr "Verstel %s"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:500
#, python-format
msgid "Removing %s"
msgstr "Verwyder %s"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:502
#, python-format
msgid "Completely removing %s"
msgstr "Verwyder %s volledig"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:504
#, python-format
msgid "Noting disappearance of %s"
msgstr "Teken verdwyning van %s aan"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:506
#, python-format
msgid "Running post-installation trigger %s"
msgstr "Hardloop postinstallasie sneller %s"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:508
#, python-format
msgid "Upgrading %s"
msgstr "Opgradeer %s"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:510
#, python-format
msgid "Unpacking %s"
msgstr "Pak %s uit"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:512
#, python-format
msgid "Preparing installation of %s"
msgstr "Berei installasie van %s voor"

#. TRANSLATORS: %s is the name of a package
#: aptkit/enums.py:514
#, python-format
msgid "Preparing configuration of %s"
msgstr "Berei verstelling van %s voor"

