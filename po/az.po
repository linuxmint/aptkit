#: aptkit/enums.py:314
msgid "Search done"
msgstr "Axtarış tamamlandı"

#: aptkit/enums.py:315
msgid "Removed packages"
msgstr "Silinmiş paketlər"

#: aptkit/enums.py:316
msgid "Updated packages"
