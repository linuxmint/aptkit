#: data/org.aptkit.policy.in:12
msgid "List keys of trusted vendors"
msgstr "Etibarlı satıcıların açarlar siyahısı"

#: data/org.aptkit.policy.in:13
msgid "To view the list of trusted keys, you need to authenticate."
msgstr ""
"Etibarlı açarların siyahısına baxmaq üçün autentifikasiya etməlisiniz."

#: data/org.aptkit.policy.in:22
msgid "Remove downloaded package files"
msgstr "Yüklənmiş paket fayllarını sil"

#: data/org.aptkit.policy.in:23
msgid "To clean downloaded package files, you need to authenticate."
msgstr "Yüklənmiş paket fayllarını təmizləmək üçün təsdiqləməlisiz."

#: data/org.aptkit.policy.in:32
msgid "Change software configuration"
msgstr "Proqram təminatının konfiqurasiyasını dəyiş"

#: data/org.aptkit.policy.in:33
msgid "To change software settings, you need to authenticate."
msgstr "Proqram parametrlərini dəyişdirmək üçün autentifikasiya etməlisiniz."

#: data/org.aptkit.policy.in:42
msgid "Change software repository"
msgstr "Proqram təminatı repositorunu dəyiş"

#: data/org.aptkit.policy.in:43
msgid "To change software repository settings, you need to authenticate."
msgstr ""
"Proqram deposunun parametrlərini dəyişmək üçün autentifikasiya etməlisiniz."

#: data/org.aptkit.policy.in:52
msgid "Install package file"
msgstr "Paket faylını quraşdır"

#: data/org.aptkit.policy.in:53
msgid "To install this package, you need to authenticate."
msgstr "Bu paketi quraşdırmaq üçün, həqiqiliyinizi təsdiq etməlisiniz."

#: data/org.aptkit.policy.in:62
msgid "Update package information"
msgstr "Paket məlumatını yeniləyin"

#: data/org.aptkit.policy.in:63
msgid "To update the software catalog, you need to authenticate."
msgstr "Proqram kataloqunu yeniləmək üçün təsdiqləməlisiz."

#: data/org.aptkit.policy.in:72
msgid "Install or remove packages"
msgstr "Paketləri yüklə və ya sil"

#: data/org.aptkit.policy.in:73
msgid "To install or remove software, you need to authenticate."
msgstr "Proqramı quraşdırmaq və ya silmək üçün autentifikasiya etməlisiniz."

#. This priviledge will be requested when installing a package
#. from a high trusted repository that can be explicitely whitelisted.
#. 
#. The defaults for this action are the same as
#. "org.aptkit.install-or-remove-packages".
#. 
#. The admin can override them to e.g. allow passwordless installs for
#. leightweight applications like unity-webapps or for packages
#. comming from high trust repositories (like internal repositories)
#: data/org.aptkit.policy.in:92
msgid "Install software from a high-trust whitelisted repository."
msgstr "Proqramı yüksək etibarlı ağ siyahıya alınmış depodan quraşdırın."

#: data/org.aptkit.policy.in:93
msgid "To install software, you need to authenticate."
msgstr "Proqramı quraşdırmaq üçün autentifikasiya etməlisiniz."

#. This privilege allows to call AddRepository, UpdateCache(Partially)
#. and InstallPackages in a row and only authenticating once.
#. 
#. The client has to authenticate for this privilege before calling
#. the aptkit methods.
#: data/org.aptkit.policy.in:107
msgid "Add a new repository and install packages from it"
msgstr "Yeni repositor əlavə et və ordan paketlər yüklə"

#: data/org.aptkit.policy.in:108
msgid "To install software from a new source, you need to authenticate."
msgstr "Proqramı yeni mənbədən quraşdırmaq üçün autentifikasiya etməlisiniz."

#. This privilege allows to call AddRepository, UpdateCache(Partially)
#. and InstallPackages in a row and only authenticating once.
#. 
#. The client has to authenticate for this privilege before calling
#. the aptkit methods.
#. 
#. The only difference to install-packages-from-new-repo is the wording
#. of the message. It is required by Ubuntu's Software-Center.
#: data/org.aptkit.policy.in:125
msgid ""
"Add a new repository of purchased software and install packages from it"
msgstr ""
"Alınmış proqramların yeni repositorun əlavə et və ordan paketləri yüklə"

#: data/org.aptkit.policy.in:126
msgid "To install purchased software, you need to authenticate."
msgstr "Alınmış proqramı quraşdırmaq üçün autentifikasiya etməlisiniz."

#: data/org.aptkit.policy.in:135
msgid "Upgrade packages"
msgstr "Paketləri yüksəlt"

#: data/org.aptkit.policy.in:136
msgid "To install updated software, you need to authenticate."
msgstr ""
"Yenilənmiş proqram təminatını quraşdırmaq üçün autentifikasiya etməlisiniz."

#: data/org.aptkit.policy.in:145
msgid "Cancel the task of another user"
msgstr "Başqa istifadəçinin işini dayandır"

#: data/org.aptkit.policy.in:146
msgid "To cancel someone else's software changes, you need to authenticate."
msgstr ""
"Başqasının proqram dəyişikliklərini ləğv etmək üçün autentifikasiya "
"etməlisiniz."

#: data/org.aptkit.policy.in:155
msgid "Set a proxy for software downloads"
msgstr "Proqram təminatını yükləmək üçün proxy müəyyən et"

#: data/org.aptkit.policy.in:156
msgid ""
"To use a proxy server for downloading software, you need to authenticate."
msgstr ""
"Proqramları yükləmək üçün proksi serverdən istifadə etmək üçün "
"autentifikasiya etməlisiniz."

#: aptkit/core.py:2030
msgid "Do not shutdown the daemon because of inactivity"
msgstr "Qeyri-aktivlik səbəbindən daemonu söndürməyin"

#: aptkit/core.py:2035
msgid "Do not load any plugins"
msgstr "Heç bir qoşmanı (plugin) yükləməyin"

#: aptkit/core.py:2039
msgid "Show internal processing information"
msgstr "Daxili emal məlumatlarını göstər"

#: aptkit/core.py:2044
msgid "Quit and replace an already running daemon"
msgstr "Artıq işləyən daemonu dayandır və əvəz et"

#: aptkit/core.py:2049
msgid "Listen on the DBus session bus (Only required for testing"
msgstr "DBus sessiya şinini dinlə (Yalnız test üçün tələb olunur)"

#: aptkit/core.py:2053
msgid "Perform operations in the given chroot"
msgstr "Əməliyyatları verilmiş chroot mühitində yerinə yetir"

#: aptkit/core.py:2058
msgid "Store profile stats in the specified file"
msgstr "Profil statistikasını göstərilən faylda saxla"

#: aptkit/core.py:2063
msgid "Do not make any changes to the system (Only of use to developers)"
msgstr ""
"Sistemdə heç bir dəyişiklik etməyin (Yalnız tərtibatçılar üçün faydalıdır)"

#: aptkit/enums.py:311
msgid "Installed file"
msgstr "Quraşdırılmış fayl"

#: aptkit/enums.py:312
msgid "Installed packages"
msgstr "Quraşdırılmış paketlər"

#: aptkit/enums.py:313
