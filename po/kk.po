#: aptkit/worker/aptworker.py:1328
#, python-format
msgid "The license key already exists: %s"
msgstr "Лицензия кілті қазірдің өзінде бар: %s"

#: aptkit/worker/aptworker.py:1333
#, python-format
msgid ""
"The location of the license key is unsecure since it contains symbolic "
"links. The path %s maps to %s"
msgstr ""
"Лицензия кілтінің орналасқан жері қауіпсіз емес, өйткені онда символдық "
"сілтемелер бар. %s жолы %s жолына нұсқайды"

#: aptkit/worker/aptworker.py:1341
#, python-format
msgid "The directory where to install the key to doesn't exist yet: %s"
msgstr "Кілтті орнататын бума әлі жоқ: %s"

#: aptkit/worker/aptworker.py:1352
#, python-format
msgid "Failed to write key file to: %s"
msgstr "Кілт файлын мына жерге жазу сәтсіз аяқталды: %s"

#: aptkit/worker/aptworker.py:1419
msgid "The following packages have unmet dependencies:"
msgstr "Келесі дестелердің орындалмаған тәуелділіктері бар:"

#: aptkit/worker/aptworker.py:1449
msgid "but it is a virtual package"
msgstr "бірақ бұл виртуалды десте"

#: aptkit/worker/aptworker.py:1452
msgid "but it is not installable"
msgstr "бірақ оны орнату мүмкін емес"

#: aptkit/worker/aptworker.py:1454
msgid "but it is not installed"
msgstr "бірақ ол орнатылмаған"

#: aptkit/worker/aptworker.py:1456
msgid "but it is not going to be installed"
msgstr "бірақ ол орнатылмайды"

#. TRANSLATORS: %s is a version number
#: aptkit/worker/aptworker.py:1460
#, python-format
msgid "but %s is installed"
msgstr "бірақ %s орнатылған"

#. TRANSLATORS: %s is a version number
#: aptkit/worker/aptworker.py:1464
#, python-format
msgid "but %s is to be installed"
msgstr "бірақ %s орнатылуы тиіс"
