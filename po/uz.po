#: aptkit/enums.py:355
msgid "Upgrading the system failed"
msgstr "Tizimni yangilash muvaffaqiyatsiz yakunlandi."

#: data/org.aptkit.policy.in:12
msgid "List keys of trusted vendors"
msgstr "Ishonchli sotuvchilarning kalitlarini ro'yxatlash"

#: data/org.aptkit.policy.in:13
msgid "To view the list of trusted keys, you need to authenticate."
msgstr ""
"Ishonchli kalitlar ro'yxatini ko'rish uchun autentifikatsiyadan o'tishingiz "
"kerak."

#: data/org.aptkit.policy.in:22
msgid "Remove downloaded package files"
msgstr "Yuklab olingan paket fayllarini oʻchirish"

#: data/org.aptkit.policy.in:23
msgid "To clean downloaded package files, you need to authenticate."
msgstr ""
"Yuklab olingan paket fayllarini tozalash uchun autentifikatsiyadan "
"o'tishingiz kerak."

#: data/org.aptkit.policy.in:32
msgid "Change software configuration"
msgstr "Dastur konfiguratsiyasini oʻzgartiring"

#: data/org.aptkit.policy.in:33
msgid "To change software settings, you need to authenticate."
msgstr ""
"Dastur sozlamalarini oʻzgartirish uchun autentifikatsiya qilishingiz kerak."

#: data/org.aptkit.policy.in:42
msgid "Change software repository"
msgstr "Dastur repozitoriyasini oʻzgartirish"

#: data/org.aptkit.policy.in:43
msgid "To change software repository settings, you need to authenticate."
msgstr ""
"Dastur repozitoriyasi sozlamalarini oʻzgartirish uchun autentifikatsiya "
"qilishingiz kerak."

#: data/org.aptkit.policy.in:52
msgid "Install package file"
msgstr "Paket faylini oʻrnatish"

#: data/org.aptkit.policy.in:53
msgid "To install this package, you need to authenticate."
msgstr "Ushbu paketni oʻrnatish uchun autentifikatsiya qilishingiz kerak."

#: data/org.aptkit.policy.in:62
msgid "Update package information"
msgstr "Paket ma'lumotlarini yangilash"

#: data/org.aptkit.policy.in:63
msgid "To update the software catalog, you need to authenticate."
msgstr "Dastur katalogini yangilash uchun tizimga kiring"

#: data/org.aptkit.policy.in:72
msgid "Install or remove packages"
msgstr "Paketni yuklash yoki o'chirish"

#: data/org.aptkit.policy.in:73
msgid "To install or remove software, you need to authenticate."
msgstr "Dasturni yuklash yoki o'chirish uchun tizimga kiring"

#. This priviledge will be requested when installing a package
#. from a high trusted repository that can be explicitely whitelisted.
#. 
#. The defaults for this action are the same as
#. "org.aptkit.install-or-remove-packages".
#. 
#. The admin can override them to e.g. allow passwordless installs for
#. leightweight applications like unity-webapps or for packages
#. comming from high trust repositories (like internal repositories)
#: data/org.aptkit.policy.in:92
msgid "Install software from a high-trust whitelisted repository."
msgstr "Dasturni ishonchli repozitoriyadan yuklash"

#: data/org.aptkit.policy.in:93
msgid "To install software, you need to authenticate."
msgstr "Dasturni yuklash uchun tizimga kiring"

#. This privilege allows to call AddRepository, UpdateCache(Partially)
#. and InstallPackages in a row and only authenticating once.
#. 
#. The client has to authenticate for this privilege before calling
#. the aptkit methods.
#: data/org.aptkit.policy.in:107
msgid "Add a new repository and install packages from it"
msgstr "Yangi repozitoriya qo'shish va paketlarni undan yuklash"

#: data/org.aptkit.policy.in:108
msgid "To install software from a new source, you need to authenticate."
msgstr "Dasturni yangi manbadan yuklash uchun tizimga kiring"

#. This privilege allows to call AddRepository, UpdateCache(Partially)
#. and InstallPackages in a row and only authenticating once.
#. 
#. The client has to authenticate for this privilege before calling
#. the aptkit methods.
#. 
#. The only difference to install-packages-from-new-repo is the wording
#. of the message. It is required by Ubuntu's Software-Center.
#: data/org.aptkit.policy.in:125
msgid ""
"Add a new repository of purchased software and install packages from it"
msgstr ""
"Sotib olingan dasturning yangi repozitoriyaga qo‘shing va undan paketlarni "
"yuklash"

#: data/org.aptkit.policy.in:126
msgid "To install purchased software, you need to authenticate."
msgstr "Sotib olingan dasturni o'rnatish uchun tizimga kiring"

#: data/org.aptkit.policy.in:135
msgid "Upgrade packages"
msgstr "Paketlarni yangilash"

#: data/org.aptkit.policy.in:136
msgid "To install updated software, you need to authenticate."
msgstr "Yangilangan paketlarni o'rnatish uchun tizimga kiring"

#: data/org.aptkit.policy.in:145
msgid "Cancel the task of another user"
msgstr "Boshqa foydalanuvchi vazifasini bekor qilish"

#: data/org.aptkit.policy.in:146
msgid "To cancel someone else's software changes, you need to authenticate."
msgstr ""
"Boshqa kishining dasturiy o'zgarishlarini bekor qilish uchun tizimga kiring"

#: data/org.aptkit.policy.in:155
msgid "Set a proxy for software downloads"
msgstr "Dasturni yuklash uchun proksi o'rnatish"

#: data/org.aptkit.policy.in:156
msgid ""
"To use a proxy server for downloading software, you need to authenticate."
msgstr "Dasturni yuklashda proksidan foydalanish uchun tizimga kiring"

#: aptkit/core.py:2030
msgid "Do not shutdown the daemon because of inactivity"
msgstr "Fon xizmatlarni tizim faolsizligida o'chirmang"

#: aptkit/core.py:2035
msgid "Do not load any plugins"
msgstr "Hech qanday plagin o'rnatilmasin"

#: aptkit/core.py:2039
msgid "Show internal processing information"
msgstr "Ichki jarayonlar haqidagi ma'lumotlarni ko'rsatish"

#: aptkit/core.py:2044
msgid "Quit and replace an already running daemon"
msgstr "Ishlab turgan fon xizmatini to'xtatish va almashtirish"

#: aptkit/core.py:2049
msgid "Listen on the DBus session bus (Only required for testing"
msgstr "Dbus session busni tinglash ( Faqat test rejimi uchun"

#: aptkit/core.py:2053
msgid "Perform operations in the given chroot"
msgstr "Amallarni belgilangan chrootda bajarish"

#: aptkit/core.py:2058
msgid "Store profile stats in the specified file"
msgstr "Profil ma'lumotlarini ma'lum faylda saqlash"

#: aptkit/core.py:2063
msgid "Do not make any changes to the system (Only of use to developers)"
msgstr ""
"Tizimga hech qanday o'zgartirish kiritilmasin ( Faqat dasturchilar "
"foydalanishi uchun)"

#: aptkit/enums.py:311
msgid "Installed file"
msgstr "Yuklangan fayl"

#: aptkit/enums.py:312
msgid "Installed packages"
msgstr "O'rnatilgan paketlar"

#: aptkit/enums.py:313
msgid "Updated cache"
msgstr "Keshni yangilash"

#: aptkit/enums.py:314
msgid "Search done"
msgstr "Qidiruv tugallandi"

#: aptkit/enums.py:315
msgid "Removed packages"
msgstr "Olib tashlangan paketlar"

#: aptkit/enums.py:316
msgid "Updated packages"
msgstr "Yangilangan paketlar"

#: aptkit/enums.py:317
msgid "Upgraded system"
msgstr "Yangilangan tizim"

#: aptkit/enums.py:318
msgid "Applied changes"
msgstr "Amalga oshgan o'zgarishlar"

#: aptkit/enums.py:319
msgid "Repaired incomplete installation"
msgstr "Amalga oshmagan o'rnatishni tuzatish"

#: aptkit/enums.py:320
msgid "Repaired broken dependencies"
msgstr "Buzilgan bog‘liqliklar tuzatildi"

#: aptkit/enums.py:321
msgid "Added software source"
msgstr "Dastur manbasi qo'shildi"

#: aptkit/enums.py:322
msgid "Enabled component of the distribution"
msgstr "Distributiv komponenti faollashtirildi"

#: aptkit/enums.py:323
msgid "Removed downloaded package files"
msgstr "Yuklab olingan paket fayllari olib tashlandi"

#: aptkit/enums.py:324
msgid "Reconfigured installed packages"
msgstr "O‘rnatilgan paketlar qayta sozlandi"

#: aptkit/enums.py:328
msgid "Successful"
msgstr "Muvaffaqiyatli"

#: aptkit/enums.py:329
msgid "Canceled"
msgstr "Bekor qilindi"

#: aptkit/enums.py:330 aptkit/enums.py:529
msgid "Failed"
msgstr "Muvaffaqiyatsiz"

#: aptkit/enums.py:333
msgid "Installing file"
msgstr "Faylni o'rnatilmoqda"

#: aptkit/enums.py:334
msgid "Installing packages"
msgstr "Paketlar o'rnatilmoqda"

#: aptkit/enums.py:335
msgid "Updating cache"
msgstr "Kesh yangilanmoqda"

#: aptkit/enums.py:336
msgid "Removing packages"
msgstr "Paketlarni olib tashlash"

#: aptkit/enums.py:337
msgid "Updating packages"
msgstr "Paketlar yangilanmoqda"

#: aptkit/enums.py:338
msgid "Upgrading system"
msgstr "Tizim yangilanmoqda"

#: aptkit/enums.py:339 aptkit/enums.py:488
msgid "Applying changes"
msgstr "O‘zgarishlar qo‘llanilmoqda"

#: aptkit/enums.py:340
msgid "Repairing incomplete installation"
msgstr "Tugallanmagan o‘rnatishni tuzatish"

#: aptkit/enums.py:341
msgid "Repairing installed software"
msgstr "Yuklab olingan dasturiy ta'minot tuzatilmoqda"

#: aptkit/enums.py:342
msgid "Adding software source"
msgstr "Dasturiy ta'minot manbasini qo'shish"

#: aptkit/enums.py:343
msgid "Enabling component of the distribution"
msgstr "Distributiv komponentni yoqilmoqda"

#: aptkit/enums.py:344
msgid "Removing downloaded package files"
msgstr "O'rnatilgan paket fayllari olib tashlanmoqda"

#: aptkit/enums.py:345
msgid "Reconfiguring installed packages"
msgstr "Yuklangan paketlarni qayta sozlanmoqda"

#: aptkit/enums.py:346 aptkit/enums.py:477
msgid "Searching"
msgstr "Qidirilmoqda"

#: aptkit/enums.py:350
msgid "Installation of the package file failed"
msgstr "Paket fayl yuklanmasi amalga oshmadi"

#: aptkit/enums.py:351
msgid "Installation of software failed"
msgstr "Dasturiy ta'minot yuklanmasi amalga oshmadi"

#: aptkit/enums.py:352
msgid "Refreshing the software list failed"
msgstr "Dasturiy ta'minot ro'yxatini qayta yuklash amalga oshmadi"

#: aptkit/enums.py:353
msgid "Removing software failed"
msgstr "Dasturiy ta'minotni olib tashlash amalga oshmadi"

#: aptkit/enums.py:354
msgid "Updating software failed"
msgstr "Dasturiy ta'minotni yangilash amalga oshmadi"

#: aptkit/enums.py:356
msgid "Applying software changes failed"
msgstr "Dasturiy ta'minot o'zgarishlarini saqlash amalga oshmadi"

#: aptkit/enums.py:357
msgid "Repairing incomplete installation failed"
msgstr "Tugallanmagan o'rnatuvni tuzatish amalga oshmadi"

#: aptkit/enums.py:359
msgid "Repairing broken dependencies failed"
msgstr "Bog‘liqliklarni tiklashning iloji bo‘lmadi"

#: aptkit/enums.py:360
msgid "Adding software source failed"
msgstr "Dasturiy ta'minot manbasini qo'shish amalga oshmadi"

#: aptkit/enums.py:361
msgid "Enabling component of the distribution failed"
msgstr "Tarqatmaning tarkibiy qismini yoqish amalga oshmadi"

#: aptkit/enums.py:363 aptkit/enums.py:364
msgid "Removing downloaded package files failed"
msgstr "Yuklab olingan paket fayllarini o‘chirish amalga oshmadi"

#: aptkit/enums.py:365
msgid "Search failed"
msgstr "Qidiruv amalga oshmadi"

#: aptkit/enums.py:366
msgid "Adding license key"
msgstr "Litsenziya kaliti qo‘shilmoqda"

#: aptkit/enums.py:370
msgid "Check your Internet connection."
msgstr "Internet ulanishingizni tekshiring."

#: aptkit/enums.py:371
msgid "See the error details below for more information."
msgstr ""

#: aptkit/enums.py:372
msgid ""
"Check if you are using third party repositories. If so disable them, since "
"they are a common source of problems.\n"
"Furthermore run the following command in a Terminal: apt-get install -f"
msgstr ""
"Uchinchi tomon omborlaridan foydalanayotganingizni tekshiring. Agar shunday "
"bo‘lsa, ularni o‘chirib qo‘ying, chunki ular ko‘pincha muammo manbai "
"bo‘ladi.\n"
"Bundan tashqari, Terminalda quyidagi buyruqni ishga tushiring: apt-get "
"install -f"

#: aptkit/enums.py:377
msgid ""
"Check if you are currently running another software management tool, e.g. "
"Synaptic or aptitude. Only one tool is allowed to make changes at a time."
msgstr ""
"Hozirda boshqa dasturiy boshqaruv vositasini (masalan, Synaptic yoki "
"aptitude) ishga tushirganingizni tekshiring. Bir vaqtning o‘zida faqat bitta "
"vosita o‘zgartirish kiritishi mumkin."

#: aptkit/enums.py:380
msgid ""
"This is a serious problem. Try again later. If this problem appears again, "
"please report an error to the developers."
msgstr ""
"Bu jiddiy muammo. Keyinroq qayta urinib ko‘ring. Agar bu muammo yana "
"takrorlansa, iltimos, dasturchilarga xatolik haqida xabar bering."

#: aptkit/enums.py:383
msgid ""
"Check the spelling of the package name, and that the appropriate repository "
"is enabled."
msgstr ""
"Paket nomining yozilishini va tegishli ombor yoqilganligini tekshiring."

#: aptkit/enums.py:385
msgid "There isn't any need for an update."
msgstr "Yangilanishga ehtiyoj yo‘q."

#: aptkit/enums.py:386
msgid "There isn't any need for an installation"
msgstr "O‘rnatishga ehtiyoj yo‘q."

#: aptkit/enums.py:388
msgid "There isn't any need for a removal."
msgstr "Olib tashlashga ehtiyoj yo‘q."

#: aptkit/enums.py:389
msgid ""
"You requested to remove a package which is an essential part of your system."
msgstr ""
"Siz tizimingizning muhim qismi bo‘lgan paketni olib tashlashni so‘radingiz."

#: aptkit/enums.py:392
msgid ""
"The connection to the daemon was lost. Most likely the background daemon "
"crashed."
msgstr "Daemonga ulanish uzildi. Ehtimol, fondagi daemon ishdan chiqqan."

#: aptkit/enums.py:394
msgid "The installation or removal of a software package failed."
msgstr "Dasturiy paketni o‘rnatish yoki olib tashlash amalga oshmadi."

#: aptkit/enums.py:396
msgid "The requested feature is not supported."
msgstr "So‘ralgan xususiyat qo‘llab-quvvatlanmaydi."

#: aptkit/enums.py:397
msgid ""
"There seems to be a programming error in aptkit, the software that allows "
"you to install/remove software and to perform other package management "
"related tasks."
msgstr ""
"Dasturiy ta’minotni o‘rnatish/olib tashlash va paketlarni boshqarishga oid "
"boshqa vazifalarni bajarishga imkon beruvchi aptkit dasturida dasturlash "
"xatosi borga o‘xshaydi."

#: aptkit/enums.py:401
msgid ""
"This error could be caused by required additional software packages which "
"are missing or not installable. Furthermore there could be a conflict "
"between software packages which are not allowed to be installed at the same "
"time."
msgstr ""
"Bu xato kerakli qo‘shimcha dasturiy paketlarning yo‘qligi yoki o‘rnatib "
"bo‘lmasligi sababli yuzaga kelgan bo‘lishi mumkin. Bundan tashqari, bir "
"vaqtning o‘zida o‘rnatishga ruxsat etilmagan paketlar o‘rtasida ziddiyat ham "
"bo‘lishi mumkin."

#: aptkit/enums.py:407
msgid "This requires installing packages from unauthenticated sources."
msgstr "Bu tasdiqlanmagan manbalardan paketlarni o‘rnatishni talab qiladi."

#: aptkit/enums.py:409
msgid ""
"The installation could have failed because of an error in the corresponding "
"software package or it was cancelled in an unfriendly way. You have to "
"repair this before you can install or remove any further software."
msgstr ""
"O‘rnatish tegishli dasturiy paketdagi xato tufayli yoki noqulay tarzda bekor "
"qilinganligi sababli muvaffaqiyatsiz bo‘lgan bo‘lishi mumkin. Boshqa "
"dasturlarni o‘rnatish yoki olib tashlashdan oldin buni tuzatishingiz kerak."

#: aptkit/enums.py:415
msgid ""
"Please copy the file to your local computer and check the file permissions."
msgstr ""
"Iltimos, faylni mahalliy kompyuteringizga nusxalang va fayl ruxsatlarini "
"tekshiring."

#: aptkit/enums.py:418
msgid ""
"The installation of a package which violates the quality standards isn't "
"allowed. This could cause serious problems on your computer. Please contact "
"the person or organisation who provided this package file and include the "
"details beneath."
msgstr ""
"Sifat standartlariga zid bo‘lgan paketni o‘rnatishga ruxsat berilmaydi. Bu "
"kompyuteringizda jiddiy muammolarga olib kelishi mumkin. Iltimos, ushbu "
"paket faylini taqdim etgan shaxs yoki tashkilot bilan bog‘lanib, quyidagi "
"tafsilotlarni ko‘rsating."

#: aptkit/enums.py:425
msgid ""
"The downloaded license key which is required to run this piece of software "
"is not valid or could not be installed correctly.\n"
"See the details for more information."
msgstr ""
"Ushbu dasturni ishga tushirish uchun zarur bo‘lgan yuklab olingan litsenziya "
"kaliti yaroqsiz yoki to‘g‘ri o‘rnatilmagan.\n"
"Qo‘shimcha ma’lumot uchun tafsilotlarni ko‘ring."

#: aptkit/enums.py:431
msgid "All available upgrades have already been installed."
msgstr "Barcha mavjud yangilanishlar allaqachon o‘rnatilgan."

#: aptkit/enums.py:433
msgid ""
"The license key which allows you to use this piece of software could not be "
"downloaded. Please check your network connection."
msgstr ""
"Ushbu dasturdan foydalanishga ruxsat beruvchi litsenziya kalitini yuklab "
"bo‘lmadi. Iltimos, tarmoq ulanishingizni tekshiring."

#: aptkit/enums.py:437
msgid "You don't have the required privileges to perform this action."
msgstr "Ushbu amalni bajarish uchun sizda zarur huquqlar mavjud emas."

#: aptkit/enums.py:439
msgid ""
"You either provided a wrong password or cancelled the authorization.\n"
"Furthermore there could also be a technical reason for this error if you "
"haven't seen a password dialog: your desktop environment doesn't provide a "
"PolicyKit session agent."
msgstr ""
"Siz noto‘g‘ri parol kiritdingiz yoki ruxsat berishni bekor qildingiz.\n"
"Bundan tashqari, agar siz parol oynasini ko‘rmagan bo‘lsangiz, bu xatoning "
"texnik sababi ham bo‘lishi mumkin: ish stoli muhitingiz PolicyKit sessiya "
"agentini taqdim etmaydi."

#: aptkit/enums.py:447
msgid "Failed to download package files"
msgstr "Paket fayllarini yuklab olish amalga oshmadi"

#: aptkit/enums.py:448
msgid "Failed to download repository information"
msgstr "Ombor ma’lumotlarini yuklab olish amalga oshmadi"

#: aptkit/enums.py:450
msgid "Package dependencies cannot be resolved"
msgstr "Paket bog‘liqliklarini hal qilib bo‘lmadi"

#: aptkit/enums.py:451
msgid "The package system is broken"
msgstr "Paket tizimi buzilgan"

#: aptkit/enums.py:452
msgid "Failed to lock the package manager"
msgstr "Paket boshqaruvchisini qulflash amalga oshmadi"

#: aptkit/enums.py:453
msgid "Failed to load the package list"
msgstr "Paketlar ro‘yxatini yuklash amalga oshmadi"

#: aptkit/enums.py:454
msgid "Package does not exist"
msgstr "Paket mavjud emas"

#: aptkit/enums.py:455
msgid "Package is already up to date"
msgstr "Paket allaqachon yangilangan"

#: aptkit/enums.py:456
msgid "Package is already installed"
msgstr "Paket allaqachon o‘rnatilgan"

#: aptkit/enums.py:457
msgid "Package isn't installed"
msgstr "Paket o‘rnatilmagan"

#: aptkit/enums.py:458
msgid "Failed to remove essential system package"
msgstr "Muhim tizim paketini olib tashlash amalga oshmadi"

#: aptkit/enums.py:460
msgid "Task cannot be monitored or controlled"
msgstr "Vazifani kuzatish yoki boshqarish mumkin emas"

#: aptkit/enums.py:461
msgid "Package operation failed"
msgstr "Paket operatsiyasi amalga oshmadi"

#: aptkit/enums.py:462
msgid "Requires installation of untrusted packages"
msgstr "Ishonchsiz paketlarni o‘rnatish talab qilinadi"

#: aptkit/enums.py:464
msgid "Previous installation hasn't been completed"
msgstr "Oldingi o‘rnatish tugallanmagan"

#: aptkit/enums.py:465
msgid "The package is of bad quality"
msgstr "Paket sifatsiz"

#: aptkit/enums.py:466
msgid "Package file could not be opened"
msgstr "Paket faylini ochib bo‘lmadi"

#: aptkit/enums.py:467
msgid "Not supported feature"
msgstr "Qo‘llab-quvvatlanmaydigan xususiyat"

#: aptkit/enums.py:468
msgid "Failed to download the license key"
msgstr "Litsenziya kalitini yuklab olish amalga oshmadi"

#: aptkit/enums.py:469
msgid "Failed to install the license key"
msgstr "Litsenziya kalitini o‘rnatish amalga oshmadi"

#: aptkit/enums.py:470
msgid "The system is already up to date"
msgstr "Tizim allaqachon yangilangan"

#: aptkit/enums.py:471
msgid "You could not be authorized"
msgstr "Sizga ruxsat berilmadi"

#: aptkit/enums.py:472
msgid "You are not allowed to perform this action"
msgstr "Sizga bu amalni bajarishga ruxsat yo‘q"

#: aptkit/enums.py:473
msgid "An unhandlable error occured"
msgstr "Bartaraf etib bo‘lmaydigan xato yuz berdi"

#: aptkit/enums.py:476
msgid "Waiting for service to start"
msgstr "Xizmat ishga tushishi kutilmoqda"

#: aptkit/enums.py:478
msgid "Waiting"
msgstr "Kutilmoqda"

#: aptkit/enums.py:479
msgid "Waiting for required medium"
msgstr "Kerakli vosita kutilmoqda"

#: aptkit/enums.py:480
msgid "Waiting for other software managers to quit"
msgstr "Boshqa dasturiy boshqaruvchilar yopilishi kutilmoqda"

#: aptkit/enums.py:481
msgid "Waiting for configuration file prompt"
msgstr "Konfiguratsiya fayli so‘rovi kutilmoqda"

#: aptkit/enums.py:483
msgid "Running task"
msgstr "Ishlayotgan vazifa"

#: aptkit/enums.py:484
msgid "Downloading"
msgstr "Yuklab olinmoqda"

#: aptkit/enums.py:485
msgid "Querying software sources"
msgstr "Dasturiy manbalar so‘ralmoqda"

#: aptkit/enums.py:486
msgid "Cleaning up"
msgstr "Tozalash"

#: aptkit/enums.py:487
msgid "Resolving dependencies"
msgstr "Bog‘liqliklar hal qilinmoqda"

#: aptkit/enums.py:489
msgid "Finished"
msgstr "Tugallandi"

