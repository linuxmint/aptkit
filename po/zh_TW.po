msgstr "無法獲授權"

#: aptkit/enums.py:472
msgid "You are not allowed to perform this action"
msgstr "不能進行此動作"

#: aptkit/enums.py:473
msgid "An unhandlable error occured"
msgstr "遭遇到無法處理的錯誤"

#: aptkit/enums.py:476
